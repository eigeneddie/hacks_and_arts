# Files and folders git should ignore (never commit, never push).
# One pattern per line. A trailing / means "this folder".

# Personal notes, kept local only
edgarsnotes/

# Python's cache of compiled scripts, rebuilt automatically
__pycache__/

# Gallery originals (any size). Only the resized copies in
# images/gallery/ get committed. See scripts/resize_gallery.py
images/gallery_og/
